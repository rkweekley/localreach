# ---------- required in production ----------
# APP_ENV=production makes the process REFUSE TO BOOT rather than run
# half-configured. Leave it as development only on your laptop.
APP_ENV=production

# openssl rand -hex 32   (nothing works without this)
API_TOKEN=

# openssl rand -hex 32   (signs unsubscribe links; changing it invalidates
# every link already sitting in someone's inbox)
UNSUB_SECRET=

# Must be https in production: unsubscribe links are built from it, and a
# plain-http link is a deliverability and privacy problem.
PUBLIC_BASE_URL=https://reach.cyberalsolutions.com

# ---------- sending ----------
# Starts CLOSED: nothing leaves the box until you set DRY_RUN=0 on purpose.
DRY_RUN=1
MAILGUN_DOMAIN=cyberalsolutions.com
MAILGUN_API_KEY=
MAILGUN_SENDER=info@cyberalsolutions.com
MAILGUN_SENDER_NAME=Cyberal Solutions
# Where replies land. Runbox-hosted info@ works; leave blank to keep replies
# inside the app only.
MAILGUN_REPLY_TO=info@cyberalsolutions.com
# Forward every inbound reply to a human mailbox (blank = off)
REPLY_FORWARD_TO=

# Mailgun "HTTP webhook signing key" (Dashboard -> Settings -> API keys).
# Required when DRY_RUN=0: without it the webhook URLs are unauthenticated and
# anyone could forge a hard bounce or wipe a contact.
MAILGUN_SIGNING_KEY=
MAILGUN_WEBHOOK_TOLERANCE_S=900
# Mailgun retries with the same signature for 8 hours; the default 15-minute
# window is correct for a live endpoint, raise it only while debugging DNS.

# ---------- behaviour ----------
SEND_TZ=America/New_York
WORKER_LIMIT=25
WORKER_INTERVAL_S=60
LOG_LEVEL=INFO
LOCALREACH_DB=/data/localreach.db
OUTBOX_DIR=/app/outbox

# Role mailboxes (info@, sales@) are blocked as *recipients* by default. Our own
# From address is info@, which is unaffected by this flag.
ALLOW_ROLE_ADDRESSES=0

# Optional: an OpenAI-compatible endpoint for personalization. Blank falls back
# to deterministic templates, so an expired key never stops the product.
# Lead research and email drafts do NOT need this: they run through the Hermes
# agent on the workstation (scripts/hermes_worker.py), which pulls queued
# domains and posts finished leads back. Nothing has to be installed on the Mac.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# Thinking models (qwen3, deepseek-r1) burn the whole token budget in the
# reasoning channel and return empty content, which used to make research
# silently fall back to templates. "none" disables reasoning where supported.
# Leave blank for providers that reject the parameter.
AI_REASONING_EFFORT=

# --- Hermes research worker (runs on the workstation, never inside this container) ---
# The dashboard enqueues a domain; the worker claims it, runs one Hermes agent
# turn against the site, and posts the lead plus a grounded draft back.
# LOCALREACH_URL=https://reach.cyberalsolutions.com
# LOCALREACH_TOKEN=same value as API_TOKEN
# WORKSPACE_ID=
# BATCH=1
# AGENT_TIMEOUT_S=300
# DRY_RUN=1
