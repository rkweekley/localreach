# ---- sender identity (required in production) ----
MAILGUN_DOMAIN=mg.cyberalsolutions.com
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxx
MAILGUN_SENDER=ryan@cyberalsolutions.com
MAILGUN_SENDER_NAME=Ryan Weekley
MAILGUN_REPLY_TO=ryan@cyberalsolutions.com
PUBLIC_BASE_URL=https://reach.cyberalsolutions.com

# ---- safety ----
# 1 = render into ./outbox/ and never call Mailgun. Keep at 1 until the domain
# is authenticated (SPF/DKIM/DMARC green) and a real reply has been tested.
DRY_RUN=1
ALLOW_ROLE_ADDRESSES=0

# ---- data ----
LOCALREACH_DB=./localreach.db
UNSUB_SECRET=generate-with-openssl-rand-hex-32

# ---- optional LLM (OpenAI-compatible). Omit and the app uses templates. ----
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=qwen3.5:9b-64k
# AI_API_KEY=ollama
